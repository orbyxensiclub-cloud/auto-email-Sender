generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Assignment {
  id                                 String    @id
  userId                             String?
  projectId                          String?
  assignedById                       String?
  roleOnProject                      String
  startDate                          DateTime
  createdAt                          DateTime  @default(now())
  updatedAt                          DateTime
  userName                           String
  userEmail                          String
  projectName                        String
  endDate                            DateTime?
  User_Assignment_assignedByIdToUser User?     @relation("Assignment_assignedByIdToUser", fields: [assignedById], references: [id])
  Project                            Project?  @relation(fields: [projectId], references: [id])
  User_Assignment_userIdToUser       User?     @relation("Assignment_userIdToUser", fields: [userId], references: [id])

  @@unique([userId, projectId])
}

model Project {
  id           String        @id
  name         String
  status       ProjectStatus @default(PLANNED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  deliveryDate DateTime?
  Assignment   Assignment[]
  Sheet        Sheet[]
  Task         Task[]
}

model Sheet {
  id        String    @id
  name      String    @default("Untitled Sheet")
  columns   Json
  rows      Json
  createdAt DateTime  @default(now())
  updatedAt DateTime
  projectId String?
  kind      SheetKind @default(PROGRESS)
  Project   Project?  @relation(fields: [projectId], references: [id])

  @@unique([projectId, kind])
}

model Task {
  id                            String      @id
  title                         String
  status                        TaskStatus  @default(IN_PROGRESS)
  projectId                     String
  estimatedDays                 Float?
  createdAt                     DateTime    @default(now())
  updatedAt                     DateTime
  assigneeLLRId                 String?
  assigneeLLTId                 String?
  codeVersion                   String?
  complexity                    Int?
  fileC                         String?
  functionName                  String?
  iqa                           String?
  its                           String?
  llrId                         String?
  sheetRowId                    String?
  User_Task_assigneeLLRIdToUser User?       @relation("Task_assigneeLLRIdToUser", fields: [assigneeLLRId], references: [id])
  User_Task_assigneeLLTIdToUser User?       @relation("Task_assigneeLLTIdToUser", fields: [assigneeLLTId], references: [id])
  Project                       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  TimeEntry                     TimeEntry[]

  @@unique([projectId, sheetRowId])
}

model TimeEntry {
  id        String   @id
  userId    String
  taskId    String
  days      Float
  loggedAt  DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
  Task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id])
}

model User {
  id                                       String       @id
  name                                     String       @unique
  email                                    String       @unique
  role                                     Role
  password                                 String
  managerId                                String?
  createdAt                                DateTime     @default(now())
  updatedAt                                DateTime
  artifact_type                            Artifact?
  seniority_level                          Level?
  hiredAt                                  DateTime?
  Assignment_Assignment_assignedByIdToUser Assignment[] @relation("Assignment_assignedByIdToUser")
  Assignment_Assignment_userIdToUser       Assignment[] @relation("Assignment_userIdToUser")
  Task_Task_assigneeLLRIdToUser            Task[]       @relation("Task_assigneeLLRIdToUser")
  Task_Task_assigneeLLTIdToUser            Task[]       @relation("Task_assigneeLLTIdToUser")
  TimeEntry                                TimeEntry[]
  User                                     User?        @relation("UserToUser", fields: [managerId], references: [id])
  other_User                               User[]       @relation("UserToUser")
}

enum Artifact {
  HLT
  LLT
  LLR
  CODE_REVIEW
  ARCHITECTURE
}

enum Level {
  JUNIOR
  MID
  SENIOR
  EXPERT
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum Role {
  UNIT_MANAGER
  ENGAGEMENT_MANAGER
  CONSULTANT
}

enum SheetKind {
  PROGRESS
  ITS
  IQA
}

enum TaskStatus {
  IN_PROGRESS
  READY_FOR_DRY_RUN
  DRY_RUN_IN_PROGRESS
  READY_FOR_TC
  TC_DONE
  TC_CORRECTION
  READY_FOR_QC
  READY_FOR_DELIVERY
  DELIVERED
  OUT_OF_SCOPE
  BLOCKED
}
